  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#ten-steps",
   "title": "Ten steps",
   "text": ""
  },
  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#brief-the-ai",
   "title": "Brief the AI",
   "text": ""
  },
  {
   "kind": "prompt",
   "chapter": "Build",
   "href": "/build#brief-the-ai",
   "title": "Brief the AI: prompt",
   "text": "I want a minimalist cinematic scroll site about [subject] for [audience]. The visitor should finish by [one action]. Propose the sections, one line each, and wait for my approval before writing any code."
  },
  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#generate-the-skeleton",
   "title": "Generate the skeleton",
   "text": ""
  },
  {
   "kind": "prompt",
   "chapter": "Build",
   "href": "/build#generate-the-skeleton",
   "title": "Generate the skeleton: prompt",
   "text": "Create index.html, style.css and app.js using plain HTML, CSS and JavaScript, no framework. Black background, one accent colour, one pair of Google Fonts. Define all colours as CSS custom properties. Include a hero, three content sections, one call to action and a short footer."
  },
  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#add-smooth-scrolling",
   "title": "Add smooth scrolling",
   "text": ""
  },
  {
   "kind": "prompt",
   "chapter": "Build",
   "href": "/build#add-smooth-scrolling",
   "title": "Add smooth scrolling: prompt",
   "text": "Add Lenis smooth scrolling from the jsDelivr CDN, pinned to lenis@1.1.18 and driven by requestAnimationFrame. Do not start it when prefers-reduced-motion is set."
  },
  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#reveal-on-scroll",
   "title": "Reveal on scroll",
   "text": ""
  },
  {
   "kind": "prompt",
   "chapter": "Build",
   "href": "/build#reveal-on-scroll",
   "title": "Reveal on scroll: prompt",
   "text": "Reveal every .reveal element once when it enters the viewport: opacity and a 24 px rise, staggered by 80 ms among siblings. Add the hidden state only under a .js class on the html element."
  },
  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#give-the-hero-depth",
   "title": "Give the hero depth",
   "text": ""
  },
  {
   "kind": "prompt",
   "chapter": "Build",
   "href": "/build#give-the-hero-depth",
   "title": "Give the hero depth: prompt",
   "text": "Give the hero three background layers with data-speed 0.2, 0.35 and 0.5, moved with translate3d on scroll. Stop updating after 1.3 viewport heights. Reduce the offsets under 768 px instead of removing them."
  },
  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#add-one-pinned-moment",
   "title": "Add one pinned moment",
   "text": ""
  },
  {
   "kind": "prompt",
   "chapter": "Build",
   "href": "/build#add-one-pinned-moment",
   "title": "Add one pinned moment: prompt",
   "text": "Turn the six feature cards into one pinned horizontal scroll section. Set the wrapper height from the track width after fonts load and on resize, so scroll distance equals the overflow."
  },
  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#tell-a-story-with-scrollytelling",
   "title": "Tell a story with scrollytelling",
   "text": ""
  },
  {
   "kind": "prompt",
   "chapter": "Build",
   "href": "/build#tell-a-story-with-scrollytelling",
   "title": "Tell a story with scrollytelling: prompt",
   "text": "Build a scrollytelling section: a sticky visual on the left that changes with the active step, and four text steps on the right. On screens under 900 px, stack them with the visual sticky at the top."
  },
  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#add-a-particle-or-3d-hero",
   "title": "Add a particle or 3D hero",
   "text": ""
  },
  {
   "kind": "prompt",
   "chapter": "Build",
   "href": "/build#add-a-particle-or-3d-hero",
   "title": "Add a particle or 3D hero: prompt",
   "text": "Add a Three.js particle hero using the cdnjs build pinned to an exact version. Sample the points from an image drawn to a canvas. Cap pixel ratio at 2, halve the count under 768 px, and pause rendering when the hero is off screen. Tell me what you could not test."
  },
  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#phone-and-accessibility-pass",
   "title": "Phone and accessibility pass",
   "text": ""
  },
  {
   "kind": "prompt",
   "chapter": "Build",
   "href": "/build#phone-and-accessibility-pass",
   "title": "Phone and accessibility pass: prompt",
   "text": "Check the page at 375, 768 and 1440 px and list anything overlapping, clipped or unreadable. Make prefers-reduced-motion disable smooth scroll, parallax and reveal movement. Add a skip link, visible focus styles and aria-current on the active menu item."
  },
  {
   "kind": "section",
   "chapter": "Build",
   "href": "/build#review-like-an-art-director",
   "title": "Review like an art director",
   "text": ""
  },
  {
   "kind": "prompt",
   "chapter": "Build",
   "href": "/build#review-like-an-art-director",
   "title": "Review like an art director: prompt",
   "text": "Act as a strict art director. Score the page 1 to 10 for hierarchy, pacing and mobile readability. List the three worst problems with where they are, fix them, and score again. Say which checks you could not run."
  },
